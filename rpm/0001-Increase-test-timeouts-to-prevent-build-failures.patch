From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matti Viljanen <matti.viljanen@jolla.com>
Date: Mon, 7 Sep 2026 08:14:23 +0300
Subject: [PATCH] Increase test timeouts to prevent build failures

---
 xdelta3/CMakeLists.txt | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/xdelta/CMakeLists.txt b/xdelta/CMakeLists.txt
index b01c906..7ef4270 100644
--- a/xdelta/CMakeLists.txt
+++ b/xdelta/CMakeLists.txt
@@ -319,7 +319,7 @@ if(XD3_BUILD_TESTS)
 
   enable_testing()
   add_test(NAME xdelta3_builtin_test COMMAND xdelta3 test)
-  set_tests_properties(xdelta3_builtin_test PROPERTIES TIMEOUT 600)
+  set_tests_properties(xdelta3_builtin_test PROPERTIES TIMEOUT 1200)
 
   # External-compression level detection round-trip.  Only meaningful where the
   # POSIX external-compression path is compiled (i.e. not the Windows
@@ -330,7 +330,7 @@ if(XD3_BUILD_TESTS)
         sh ${CMAKE_CURRENT_SOURCE_DIR}/testing/recompress_level_test.sh
         $<TARGET_FILE:xdelta3>)
     set_tests_properties(xdelta3_recompress_level_test
-      PROPERTIES TIMEOUT 120)
+      PROPERTIES TIMEOUT 240)
   endif()
 
   # Consumer smoke test: links the core library via its public API and runs a
